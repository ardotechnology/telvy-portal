---
import { checkRateLimit, recordFailedAttempt, resetRateLimit } from '../lib/rate_limiter';

let errorMessage = '';
const clientIp =
  Astro.clientAddress ||
  Astro.request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() ||
  '127.0.0.1';

if (Astro.request.method === 'POST') {
  const rateStatus = checkRateLimit(clientIp);
  if (!rateStatus.allowed) {
    errorMessage = `Demasiados intentos fallidos. Bloqueado temporalmente por ${rateStatus.remainingSeconds} segundos.`;
  } else {
    try {
      const formData = await Astro.request.formData();
      const email = String(formData.get('email') || '').trim();
      const password = String(formData.get('password') || '');
      const rawRedirect = String(formData.get('redirect') || '/');

      // Sanitizar redirección para garantizar que sea estrictamente interna
      const safeRedirect =
        rawRedirect.startsWith('/') && !rawRedirect.startsWith('//') && !rawRedirect.includes('://')
          ? rawRedirect
          : '/';

      if (!email || !password) {
        errorMessage = 'Correo o contraseña incorrectos';
      } else {
        const { data, error } = await Astro.locals.supabase.auth.signInWithPassword({
          email,
          password
        });

        if (error || !data.user) {
          recordFailedAttempt(clientIp);
          errorMessage = 'Correo o contraseña incorrectos';
        } else {
          resetRateLimit(clientIp);
          return Astro.redirect(safeRedirect);
        }
      }
    } catch {
      errorMessage = 'Correo o contraseña incorrectos';
    }
  }
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Iniciar Sesión — Portal de Cliente Telvy</title>
  <style>
    :root {
      --color-highlighter-yellow: #e4f222;
      --color-ink: #0c0a08;
      --color-obsidian: #1a1919;
      --color-paper: #ffffff;
      --color-bone: #f4f2f0;
      --color-ash: #6d6c6b;
      --color-hairline: #e5e7eb;
      --color-smoke: #d3d3d3;
      --radius-card: 14px;
      --radius-sm: 6px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--color-bone);
      color: var(--color-ink);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 24px;
    }

    .login-container {
      width: 100%;
      max-width: 420px;
    }

    .brand-header {
      text-align: center;
      margin-bottom: 24px;
    }

    .brand-title {
      font-size: 28px;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--color-ink);
    }

    .brand-subtitle {
      font-size: 14px;
      color: var(--color-ash);
      margin-top: 4px;
    }

    .card {
      background-color: var(--color-paper);
      border: 1px solid var(--color-hairline);
      border-radius: var(--radius-card);
      padding: 32px 28px;
      box-shadow: none;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 18px;
    }

    label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-ash);
    }

    input[type="email"],
    input[type="password"] {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid var(--color-smoke);
      border-radius: var(--radius-sm);
      font-size: 15px;
      color: var(--color-ink);
      background-color: var(--color-paper);
      outline: none;
      transition: border-color 0.15s;
    }

    input[type="email"]:focus,
    input[type="password"]:focus {
      border-color: var(--color-ink);
    }

    .btn-submit {
      width: 100%;
      padding: 13px;
      background-color: var(--color-ink);
      color: #ffffff;
      border: none;
      border-radius: var(--radius-sm);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      margin-top: 8px;
      transition: background-color 0.15s, opacity 0.15s;
    }

    .btn-submit:hover {
      background-color: #262626;
    }

    .alert-error {
      background-color: #fef2f2;
      border: 1px solid #fecaca;
      color: #991b1b;
      padding: 12px 14px;
      border-radius: var(--radius-sm);
      font-size: 13px;
      margin-bottom: 20px;
      text-align: center;
    }

    .card-footer {
      margin-top: 20px;
      display: flex;
      justify-content: center;
      font-size: 13px;
    }

    .card-footer a {
      color: var(--color-ash);
      text-decoration: underline;
    }

    .card-footer a:hover {
      color: var(--color-ink);
    }

    .disclaimer {
      text-align: center;
      font-size: 11px;
      color: var(--color-ash);
      margin-top: 24px;
      line-height: 1.4;
    }
  </style>
</head>
<body>
  <div class="login-container">
    <div class="brand-header">
      <h1 class="brand-title">Telvy</h1>
      <p class="brand-subtitle">Portal de Autoservicio para Clientes</p>
    </div>

    <div class="card">
      {errorMessage && (
        <div class="alert-error" role="alert">
          {errorMessage}
        </div>
      )}

      <form method="POST" action="/login">
        <input type="hidden" name="redirect" value={Astro.url.searchParams.get('redirect') || '/'} />

        <div class="form-group">
          <label for="email">Correo Electrónico</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="usuario@empresa.com"
            required
            autocomplete="email"
          />
        </div>

        <div class="form-group">
          <label for="password">Contraseña</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="••••••••••••"
            required
            autocomplete="current-password"
          />
        </div>

        <button type="submit" class="btn-submit">
          Ingresar al Portal
        </button>
      </form>

      <div class="card-footer">
        <a href="/recuperar">¿Olvidaste tu contraseña?</a>
      </div>
    </div>

    <div class="disclaimer">
      Acceso exclusivo para clientes corporativos de Telvy.<br />
      Para solicitar una cuenta, comunícate con soporte@ardo.technology.
    </div>
  </div>
</body>
</html>

