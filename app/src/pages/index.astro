---
// Verificación de sesión: el cliente se obtiene EXCLUSIVAMENTE de la sesión autenticada en el servidor.
const cliente = Astro.locals.portalCuenta?.cliente;
const userEmail = Astro.locals.user?.email || '';

if (!cliente) {
  return Astro.redirect('/cuenta-no-vinculada');
}

const TELVY_GATE_URL = process.env.TELVY_GATE_URL || 'http://host.docker.internal:4100';
const CLIENT_API_INTERNAL_KEY = process.env.CLIENT_API_INTERNAL_KEY || '';

const headers = {
  'X-Internal-Key': CLIENT_API_INTERNAL_KEY,
  'X-Authenticated-Client': cliente
};

let saldoData: any = null;
let extensionesData: any[] = [];
let troncalesData: any[] = [];
let didsData: any[] = [];
let avisosData: any[] = [];

let errorSaldo: string | null = null;
let errorExt: string | null = null;
let errorTronk: string | null = null;
let errorDids: string | null = null;
let errorAvisos: string | null = null;
let conexionFallida = false;

try {
  const [resSaldo, resExt, resTronk, resDids, resAvisos] = await Promise.all([
    fetch(`${TELVY_GATE_URL}/v1/cliente/saldo`, { headers })
      .then(async r => ({ ok: r.ok, status: r.status, data: await r.json().catch(() => ({})) }))
      .catch(e => { conexionFallida = true; return { ok: false, status: 0, data: { error: e.message } }; }),
    fetch(`${TELVY_GATE_URL}/v1/cliente/extensiones`, { headers })
      .then(async r => ({ ok: r.ok, status: r.status, data: await r.json().catch(() => ({})) }))
      .catch(e => { conexionFallida = true; return { ok: false, status: 0, data: { error: e.message } }; }),
    fetch(`${TELVY_GATE_URL}/v1/cliente/troncales`, { headers })
      .then(async r => ({ ok: r.ok, status: r.status, data: await r.json().catch(() => ({})) }))
      .catch(e => { conexionFallida = true; return { ok: false, status: 0, data: { error: e.message } }; }),
    fetch(`${TELVY_GATE_URL}/v1/cliente/dids`, { headers })
      .then(async r => ({ ok: r.ok, status: r.status, data: await r.json().catch(() => ({})) }))
      .catch(e => { conexionFallida = true; return { ok: false, status: 0, data: { error: e.message } }; }),
    fetch(`${TELVY_GATE_URL}/v1/cliente/avisos/pendientes`, { headers })
      .then(async r => ({ ok: r.ok, status: r.status, data: await r.json().catch(() => ({})) }))
      .catch(e => ({ ok: false, status: 0, data: { error: e.message } }))
  ]);

  if (resSaldo.ok && resSaldo.data?.ok) {
    saldoData = resSaldo.data;
  } else {
    errorSaldo = resSaldo.data?.error || `HTTP ${resSaldo.status}`;
  }

  if (resExt.ok && resExt.data?.ok) {
    extensionesData = resExt.data.extensiones || [];
  } else {
    errorExt = resExt.data?.error || `HTTP ${resExt.status}`;
  }

  if (resTronk.ok && resTronk.data?.ok) {
    troncalesData = resTronk.data.troncales || [];
  } else {
    errorTronk = resTronk.data?.error || `HTTP ${resTronk.status}`;
  }

  if (resDids.ok && resDids.data?.ok) {
    didsData = resDids.data.dids || [];
  } else {
    errorDids = resDids.data?.error || `HTTP ${resDids.status}`;
  }

  if (resAvisos.ok && resAvisos.data?.ok) {
    avisosData = resAvisos.data.avisos || [];
  } else {
    errorAvisos = resAvisos.data?.error || `HTTP ${resAvisos.status}`;
  }
} catch (err: any) {
  conexionFallida = true;
  errorSaldo = err.message || 'Error de conexión con la puerta';
}

const errorConexionServicios =
  conexionFallida ||
  (errorSaldo && errorSaldo.includes('fetch failed')) ||
  (errorExt && errorExt.includes('fetch failed')) ||
  (errorTronk && errorTronk.includes('fetch failed')) ||
  (errorDids && errorDids.includes('fetch failed')) ||
  errorExt === 'HTTP 0' || errorTronk === 'HTTP 0' || errorDids === 'HTTP 0';

const estadoNoDisponible = Boolean(errorConexionServicios);

const saldoBase = Number(saldoData?.saldo_control?.saldo_base ?? saldoData?.saldo?.credit ?? 0);
const saldoReservado = Number(saldoData?.saldo_control?.saldo_reservado ?? 0);
const saldoDisponible = Number(
  saldoData?.saldo_control?.saldo_disponible ?? (saldoBase - saldoReservado)
);

// Condición estricta: SOLO "no tiene servicios" (extensiones, troncales y dids activos vacíos).
// El saldo NO interviene en la decisión.
// Si no se pudo consultar el estado (estadoNoDisponible), NO se asume sin servicios.
// Un DID reservado NO es un servicio activo.
const didsActivos = didsData.filter(
  (d: any) => !d.reservado && d.estado_inventario !== 'reservado' && Boolean(d.tiene_destino || d.timbra_en)
);
const sinServiciosActivos =
  !estadoNoDisponible &&
  extensionesData.length === 0 &&
  troncalesData.length === 0 &&
  didsActivos.length === 0;

const sinServiciosAprovisionados = sinServiciosActivos;

function formatPillStatus(tipo: 'ext' | 'trk', online: boolean, rawStatus?: string) {
  const str = String(rawStatus || '').trim();
  const latencyMatch = str.match(/(\d+\s*ms)/i);
  const latency = latencyMatch ? latencyMatch[1] : null;

  const isUnknown = !str || /unknown|unregistered/i.test(str);
  const isBareOk = str.toUpperCase() === 'OK';

  const baseLabel = tipo === 'ext'
    ? (online ? 'Registrada' : 'Desconectada')
    : (online ? 'En línea' : 'Sin respuesta');

  let subtext = '';
  if (latency) {
    subtext = latency;
  } else if (isBareOk || isUnknown) {
    subtext = 'sin verificar';
  }

  return { label: baseLabel, subtext };
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Telvy — Portal de Cliente</title>
  <style>
    :root {
      --color-highlighter-yellow: #e4f222;
      --color-ink: #0c0a08;
      --color-obsidian: #1a1919;
      --color-paper: #ffffff;
      --color-bone: #f4f2f0;
      --color-ash: #6d6c6b;
      --color-hairline: #e5e7eb;
      --color-smoke: #e0deda;
      --color-status-ok: #059669;
      --color-status-warn: #d97706;
      --color-status-off: #6b7280;
      --radius-card: 14px;
      --radius-sm: 6px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--color-bone);
      color: var(--color-ink);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      line-height: 1.5;
      padding: 24px;
      display: flex;
      justify-content: center;
    }

    .container {
      width: 100%;
      max-width: 1040px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    /* Barra superior de sesión */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 18px;
      background-color: var(--color-obsidian);
      color: #ffffff;
      border-radius: var(--radius-sm);
      font-size: 13px;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .badge-client {
      background-color: var(--color-highlighter-yellow);
      color: var(--color-ink);
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 11px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .btn-logout {
      background: none;
      border: 1px solid #404040;
      color: #e5e5e5;
      padding: 5px 12px;
      border-radius: var(--radius-sm);
      font-size: 12px;
      cursor: pointer;
      transition: background-color 0.15s, color 0.15s;
    }

    .btn-logout:hover {
      background-color: #333333;
      color: #ffffff;
    }

    /* Encabezado */
    header {
      background-color: var(--color-paper);
      border: 1px solid var(--color-hairline);
      border-radius: var(--radius-card);
      padding: 24px 28px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .brand-title {
      font-size: 26px;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--color-ink);
    }

    .brand-subtitle {
      font-size: 14px;
      color: var(--color-ash);
      margin-top: 4px;
    }

    .client-chip {
      background-color: var(--color-bone);
      border: 1px solid var(--color-smoke);
      border-radius: 20px;
      padding: 6px 14px;
      font-size: 13px;
      font-family: monospace;
      color: var(--color-ink);
    }

    /* Cards */
    .card {
      background-color: var(--color-paper);
      border: 1px solid var(--color-hairline);
      border-radius: var(--radius-card);
      padding: 24px 28px;
    }

    .card-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--color-ink);
      margin-bottom: 4px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .card-desc {
      font-size: 13px;
      color: var(--color-ash);
      margin-bottom: 18px;
    }

    /* Bloque 1: Saldo */
    .saldo-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      align-items: center;
    }

    .saldo-primary {
      background-color: var(--color-bone);
      border: 1px solid var(--color-smoke);
      border-radius: 10px;
      padding: 20px;
    }

    .saldo-label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-ash);
    }

    .saldo-value {
      font-size: 38px;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--color-ink);
      margin-top: 4px;
    }

    .saldo-breakdown {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .breakdown-row {
      display: flex;
      justify-content: space-between;
      font-size: 14px;
      padding-bottom: 6px;
      border-bottom: 1px dashed var(--color-hairline);
    }

    .breakdown-row span:first-child {
      color: var(--color-ash);
    }

    .breakdown-row span:last-child {
      font-weight: 600;
      font-family: monospace;
    }

    /* Tablas */
    .table-wrapper {
      width: 100%;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
      text-align: left;
    }

    th {
      padding: 10px 14px;
      color: var(--color-ash);
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid var(--color-hairline);
    }

    td {
      padding: 14px;
      border-bottom: 1px solid var(--color-bone);
      color: var(--color-ink);
    }

    tr:last-child td {
      border-bottom: none;
    }

    /* Badges */
    .pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 500;
    }

    .pill-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
    }

    .pill-online {
      background-color: #ecfdf5;
      color: var(--color-status-ok);
      border: 1px solid #a7f3d0;
    }
    .pill-online .pill-dot { background-color: var(--color-status-ok); }

    .pill-offline {
      background-color: #f3f4f6;
      color: var(--color-status-off);
      border: 1px solid #e5e7eb;
    }
    .pill-offline .pill-dot { background-color: var(--color-status-off); }

    .pill-meta {
      opacity: 0.85;
      font-weight: 400;
      font-size: 11px;
    }

    .pill-active {
      background-color: #eff6ff;
      color: #1d4ed8;
      border: 1px solid #bfdbfe;
    }
    .pill-active .pill-dot { background-color: #2563eb; }

    .pill-warn {
      background-color: #fefce8;
      color: #854d0e;
      border: 1px solid #fef08a;
    }
    .pill-warn .pill-dot { background-color: #ca8a04; }

    /* Empty states */
    .empty-state {
      background-color: var(--color-bone);
      border: 1px dashed var(--color-smoke);
      border-radius: 8px;
      padding: 22px;
      text-align: center;
      color: var(--color-ash);
      font-size: 14px;
    }

    footer {
      text-align: center;
      font-size: 12px;
      color: var(--color-ash);
      padding: 12px;
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Barra superior de autenticación -->
    <div class="top-bar">
      <div class="user-info">
        <span class="badge-client">Cliente {cliente}</span>
        <span>{userEmail}</span>
        <a href="/cuenta/baja" class="link-baja" style="color: #ef4444; font-size: 12px; margin-left: 12px; text-decoration: none;">Dar de baja la cuenta</a>
      </div>
      <form method="POST" action="/api/auth/logout" style="margin: 0;">
        <button type="submit" class="btn-logout">Cerrar Sesión</button>
      </form>
    </div>

    <!-- Encabezado institucional -->
    <header>
      <div>
        <h1 class="brand-title">Portal de Cliente Telvy</h1>
        <p class="brand-subtitle">Servicios e infraestructura VoIP en tiempo real</p>
      </div>
      <div class="client-chip">
        Sesión: <strong>{cliente}</strong>
      </div>
    </header>

    {estadoNoDisponible && (
      <div class="banner-aviso" role="status" style="background-color: #fef2f2; border: 1px solid #fecaca; border-left: 4px solid #dc2626; border-radius: 8px; padding: 14px 18px; margin-bottom: 24px; color: #991b1b; font-size: 14px; display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 18px;">⚠️</span>
        <div>
          <strong>Aviso:</strong> estado no disponible. No fue posible consultar los servicios de la cuenta en el conmutador.
        </div>
      </div>
    )}

    {sinServiciosActivos && (
      <div class="banner-aviso" role="status" style="background-color: #fffbeb; border: 1px solid #fde68a; border-left: 4px solid #f59e0b; border-radius: 8px; padding: 16px 20px; margin-bottom: 24px; color: #92400e; font-size: 14px; display: flex; flex-direction: column; gap: 10px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 20px;">ℹ️</span>
          <div>
            <strong>Aviso:</strong> cuenta sin servicios aprovisionados. Esta cuenta no cuenta actualmente con líneas, extensiones ni crédito configurados en el conmutador.
          </div>
        </div>
        <div style="padding-top: 10px; border-top: 1px dashed #fcd34d; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
          <span>
            Tu cuenta no tiene servicios activos.{saldoDisponible > 0 ? ` Tu saldo de $${saldoDisponible.toFixed(2)} MXN se conserva y se restablece si reactivas la cuenta.` : ''}
          </span>
          <button id="btnReactivar" style="background-color: #059669; color: #ffffff; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 600; font-size: 13px; cursor: pointer;">
            Reactivar Cuenta
          </button>
        </div>
        <div id="reactivarStatus" style="display: none; font-size: 13px; padding: 8px 12px; border-radius: 6px; background-color: #fef3c7; color: #b45309;"></div>
      </div>
    )}

    <!-- BLOQUE 1: Saldo Disponible -->
    <section class="card">
      <h2 class="card-title">1. Saldo Disponible</h2>
      <p class="card-desc">Consultado en tiempo real desde la puerta para el cliente {cliente}.</p>
      {saldoData ? (
        <div class="saldo-grid">
          <div class="saldo-primary">
            <div class="saldo-label">Saldo Disponible</div>
            <div class="saldo-value">${saldoDisponible.toFixed(2)} <span style="font-size: 18px; font-weight: 400; color: var(--color-ash);">MXN</span></div>
          </div>
          <div class="saldo-breakdown">
            <div class="breakdown-row">
              <span>Saldo Base:</span>
              <span>${saldoBase.toFixed(4)} MXN</span>
            </div>
            <div class="breakdown-row">
              <span>Saldo Reservado:</span>
              <span>${saldoReservado.toFixed(4)} MXN</span>
            </div>
            <div class="breakdown-row">
              <span>Crédito en Conmutador:</span>
              <span>${Number(saldoData.saldo?.credit ?? 0).toFixed(4)} MXN</span>
            </div>
          </div>
        </div>
      ) : (
        <div class="empty-state">
          {sinServiciosAprovisionados
            ? 'Sin saldo asignado — cuenta sin servicios aprovisionados.'
            : `No fue posible leer el saldo del cliente ${cliente} (${errorSaldo}).`}
        </div>
      )}
    </section>

    <!-- BLOQUE 2: Extensiones del Cliente -->
    <section class="card">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
        <div>
          <h2 class="card-title">2. Extensiones del Cliente</h2>
          <p class="card-desc">Líneas telefónicas de usuario aprovisionadas en el Edge.</p>
        </div>
        <a href="/cuenta/extensiones" style="font-size: 13px; font-weight: 600; text-decoration: none; padding: 6px 12px; background: var(--color-bone); border: 1px solid var(--color-smoke); border-radius: 6px; color: var(--color-ink); white-space: nowrap;">
          Gestionar contraseñas →
        </a>
      </div>
      {extensionesData.length > 0 ? (
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Nombre Extensión</th>
                <th>Host</th>
                <th>Caller ID</th>
                <th>Línea / Registro</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              {extensionesData.map((ext: any) => (
                <tr>
                  <td><strong>{ext.name}</strong></td>
                  <td><code>{ext.host}</code></td>
                  <td>{ext.callerid || 'Sin CallerID'}</td>
                  <td>
                    {(() => {
                      const st = formatPillStatus('ext', ext.online, ext.lineStatus);
                      return (
                        <span class={`pill ${ext.online ? 'pill-online' : 'pill-offline'}`}>
                          <span class="pill-dot"></span>
                          <span>{st.label}</span>
                          {st.subtext && <span class="pill-meta">· {st.subtext}</span>}
                        </span>
                      );
                    })()}
                  </td>
                  <td>{ext.activo ? 'Habilitada' : 'Inactiva'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="empty-state">
          El cliente {cliente} no tiene extensiones asignadas actualmente.
        </div>
      )}
    </section>

    <!-- BLOQUE 3: Troncales del Cliente -->
    <section class="card">
      <h2 class="card-title">3. Troncales del Cliente</h2>
      <p class="card-desc">Enlaces troncales SIP y conexiones para PBX.</p>
      {troncalesData.length > 0 ? (
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Nombre Troncal</th>
                <th>Host / IP Destino</th>
                <th>Canales Máximos</th>
                <th>Línea / Conectividad</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              {troncalesData.map((trk: any) => (
                <tr>
                  <td><strong>{trk.name}</strong></td>
                  <td><code>{trk.host}</code></td>
                  <td>{trk.max_channels} canales</td>
                  <td>
                    {(() => {
                      const st = formatPillStatus('trk', trk.online, trk.lineStatus);
                      return (
                        <span class={`pill ${trk.online ? 'pill-online' : 'pill-offline'}`}>
                          <span class="pill-dot"></span>
                          <span>{st.label}</span>
                          {st.subtext && <span class="pill-meta">· {st.subtext}</span>}
                        </span>
                      );
                    })()}
                  </td>
                  <td>{trk.activo ? 'Activa' : 'Inactiva'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="empty-state">
          El cliente {cliente} no cuenta con troncales SIP configuradas.
        </div>
      )}
    </section>

    <!-- BLOQUE 4: DIDs Asignados -->
    <section class="card">
      <h2 class="card-title">4. DIDs Asignados</h2>
      <p class="card-desc">Números telefónicos asignados y activos para recepción.</p>
      {didsData.length > 0 ? (
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Número E.164</th>
                <th>Ubicación / País</th>
                <th>Destino</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              {didsData.map((d: any) => {
                const esReservado = d.reservado || d.estado_inventario === 'reservado';
                const tieneDestino = Boolean(d.tiene_destino || d.timbra_en);
                const fechaVence = d.reserva_expira_at
                  ? new Date(d.reserva_expira_at).toLocaleDateString('es-MX', { year: 'numeric', month: 'short', day: 'numeric' })
                  : '';
                return (
                  <tr>
                    <td><code>{d.did}</code></td>
                    <td>{d.country || 'Nacional / Sin especificar'}</td>
                    <td>
                      <code>{d.timbra_en || (esReservado ? 'Sin destino (en reserva)' : 'Sin destino')}</code>
                    </td>
                    <td>
                      {esReservado ? (
                        <span class="pill pill-warn">
                          <span class="pill-dot"></span>
                          <span>Reservado para ti · vence el {fechaVence || '15 días'}</span>
                        </span>
                      ) : (d.activated && tieneDestino) ? (
                        <span class="pill pill-active"><span class="pill-dot"></span> Activo</span>
                      ) : (
                        <span class="pill pill-offline"><span class="pill-dot"></span> Inactivo</span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="empty-state">
          No hay números telefónicos (DIDs) asignados actualmente al cliente {cliente}.
        </div>
      )}
    </section>

    <!-- BLOQUE 5: Avisos del Outbox Pendientes -->
    <section class="card">
      <h2 class="card-title">5. Avisos del Outbox Pendientes</h2>
      <p class="card-desc">Notificaciones generadas pendientes de emisión.</p>
      {avisosData.length > 0 ? (
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>ID Aviso</th>
                <th>Tipo de Notificación</th>
                <th>Inactividad</th>
                <th>Fecha Generación</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              {avisosData.map((av: any) => (
                <tr>
                  <td><code>{av.id}</code></td>
                  <td><strong>{av.tipo_aviso}</strong></td>
                  <td>{av.dias_inactividad} días</td>
                  <td>{new Date(av.created_at).toLocaleString('es-MX')}</td>
                  <td><span class="pill pill-offline">Pendiente</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="empty-state">
          No disponible — pendiente de implementar
        </div>
      )}
    </section>

    <footer>
      Telvy Telecommunications · Portal de Cliente · Autenticado vía Supabase Auth
    </footer>
  </div>

  <script>
    const btnReactivar = document.getElementById('btnReactivar') as HTMLButtonElement;
    const reactivarStatus = document.getElementById('reactivarStatus') as HTMLDivElement;

    btnReactivar?.addEventListener('click', async () => {
      btnReactivar.disabled = true;
      if (reactivarStatus) {
        reactivarStatus.style.display = 'block';
        reactivarStatus.textContent = 'Enviando solicitud de reactivación al motor...';
      }

      try {
        const res = await fetch('/api/cuenta/reactivar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          if (reactivarStatus) {
            reactivarStatus.textContent = `Error al reactivar: ${data.error || 'Fallo de comunicación'}`;
          }
          btnReactivar.disabled = false;
          return;
        }

        const ordenId = data.orden_id;
        if (reactivarStatus) {
          reactivarStatus.textContent = `Reactivación encolada (Orden: ${ordenId}). Esperando finalización...`;
        }

        let intentos = 0;
        const interval = setInterval(async () => {
          intentos++;
          try {
            const checkRes = await fetch(`/api/cuenta/orden-status?orden_id=${ordenId}`);
            const checkData = await checkRes.json().catch(() => ({}));

            if (checkData.estado === 'completado') {
              clearInterval(interval);
              if (reactivarStatus) {
                reactivarStatus.textContent = '¡Cuenta reactivada exitosamente! Recargando...';
              }
              setTimeout(() => window.location.reload(), 1500);
              return;
            }

            if (checkData.estado === 'fallido') {
              clearInterval(interval);
              if (reactivarStatus) {
                reactivarStatus.textContent = `Fallo en la reactivación: ${checkData.motivo || 'Error en saga'}`;
              }
              btnReactivar.disabled = false;
              return;
            }

            if (intentos >= 20) {
              clearInterval(interval);
              if (reactivarStatus) {
                reactivarStatus.textContent = 'La reactivación continúa en proceso. Por favor recargue en unos instantes.';
              }
            }
          } catch {
            // Reintento en siguiente ciclo
          }
        }, 1500);
      } catch (err: any) {
        if (reactivarStatus) {
          reactivarStatus.textContent = `Error: ${err.message}`;
        }
        btnReactivar.disabled = false;
      }
    });
  </script>
</body>
</html>
